{
 "p01": {
  "text": "Шесть тысяч метров.",
  "start": 0.0,
  "end": 0.975
 },
 "p02": {
  "text": "Я _один._",
  "start": 1.672,
  "end": 2.194
 },
 "p03": {
  "text": "Связи нет. _Пи**ец._",
  "start": 2.694,
  "end": 4.4
 },
 "p04": {
  "text": "Минус тридцать. До рассвета восемь часов.",
  "start": 4.911,
  "end": 7.291
 },
 "p05": {
  "text": "Первое правило: не _паниковать._",
  "start": 7.79,
  "end": 9.346
 },
 "p06": {
  "text": "А я паникую.",
  "start": 9.845,
  "end": 10.577
 },
 "p07": {
  "text": "Стоп. Дышу.",
  "start": 11.088,
  "end": 12.307
 },
 "p08": {
  "text": "Ветер убивает быстрее _холода._",
  "start": 12.806,
  "end": 14.222
 },
 "p09": {
  "text": "Нахожу скалу. Рою нору руками.",
  "start": 14.733,
  "end": 16.962
 },
 "p10": {
  "text": "Капюшон не снимаю. Руки под мышки.",
  "start": 17.461,
  "end": 19.679
 },
 "p11": {
  "text": "Хочется пить. Но снег есть _нельзя._",
  "start": 20.178,
  "end": 22.43
 },
 "p12": {
  "text": "Топлю его в бутылке под курткой.",
  "start": 23.243,
  "end": 24.659
 },
 "p13": {
  "text": "Глаза закрываются.",
  "start": 25.089,
  "end": 25.971
 },
 "p14": {
  "text": "Спать _нельзя,_ с*ка!",
  "start": 26.563,
  "end": 27.875
 },
 "p15": {
  "text": "Сжимаю кулаки. Шевелю пальцами.",
  "start": 28.305,
  "end": 30.847
 },
 "p16": {
  "text": "Фонарик. Три коротких, три длинных, три коротких.",
  "start": 31.44,
  "end": 34.621
 },
 "p17": {
  "text": "Никто не _отвечает._",
  "start": 35.213,
  "end": 36.13
 },
 "p18": {
  "text": "Батарея садится.",
  "start": 36.722,
  "end": 37.663
 },
 "p19": {
  "text": "Считаю вдохи. Думаю о маме.",
  "start": 38.243,
  "end": 40.704
 },
 "p20": {
  "text": "Утром я услышал _вертолёт._",
  "start": 41.517,
  "end": 43.084
 },
 "p21": {
  "text": "Я выжил. Потому что не паниковал.",
  "start": 43.328,
  "end": 45.79
 },
 "p22": {
  "text": "Сохрани это видео. Однажды оно спасёт тебе _жизнь._",
  "start": 46.486,
  "end": 49.923
 }
}